{
  "info": {
    "_postman_id": "d5f4b6a8-4be9-4c52-9094-4b6b5a4dd77a",
    "name": "CloudNest FileSystem API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CloudNest 文件系统全链路测试集合（含变量提取脚本）"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var token = json.token || (json.data && json.data.token);",
                  "if (token) pm.environment.set('token', token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 File Basics",
      "item": [
        {
          "name": "Create Folder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parent_id\": 0,\n  \"name\": \"postman-test-folder\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/folders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "folders"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var folderId = (json.item && json.item.id) || json.id;",
                  "if (folderId) pm.environment.set('folderId', String(folderId));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Root Files",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/files?parent_id=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files"
              ],
              "query": [
                {
                  "key": "parent_id",
                  "value": "0"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Search Files",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/files/search?parent_id=0&name=postman",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "search"
              ],
              "query": [
                {
                  "key": "parent_id",
                  "value": "0"
                },
                {
                  "key": "name",
                  "value": "postman"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 Chunk Upload",
      "item": [
        {
          "name": "Init Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parent_id\": {{folderId}},\n  \"filename\": \"demo.bin\",\n  \"total_size\": 1048576,\n  \"chunk_size\": 262144,\n  \"total_chunks\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/init",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "upload",
                "init"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "if (json.upload_id) pm.environment.set('uploadId', json.upload_id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Upload Chunk (Manual Update index/md5/file)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "upload_id",
                  "value": "{{uploadId}}",
                  "type": "text"
                },
                {
                  "key": "chunk_index",
                  "value": "0",
                  "type": "text"
                },
                {
                  "key": "chunk_md5",
                  "value": "",
                  "type": "text",
                  "description": "必填：当前分片的 MD5（32位小写）"
                },
                {
                  "key": "chunk",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/chunk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "upload",
                "chunk"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Upload Progress",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/progress?upload_id={{uploadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "upload",
                "progress"
              ],
              "query": [
                {
                  "key": "upload_id",
                  "value": "{{uploadId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Complete Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upload_id\": \"{{uploadId}}\",\n  \"parent_id\": {{folderId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "upload",
                "complete"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var fileId = (json.item && json.item.id) || (json.file && json.file.id) || json.id;",
                  "if (fileId) pm.environment.set('fileId', String(fileId));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Download",
      "item": [
        {
          "name": "Download File",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{fileId}}",
                "download"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Download File (Range 0-1023)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Range",
                "value": "bytes=0-1023"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{fileId}}",
                "download"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Download Folder Zip",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/files/{{folderId}}/download-zip",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{folderId}}",
                "download-zip"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Batch Download",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_ids\": [{{fileId}}, {{folderId}}]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/batch-download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "batch-download"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 Delete & Recycle",
      "item": [
        {
          "name": "Batch Delete",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_ids\": [{{fileId}}]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/batch-delete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "batch-delete"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Recycle Bin",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/files/recycle-bin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "recycle-bin"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Restore File",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}/restore",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{fileId}}",
                "restore"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 Share",
      "item": [
        {
          "name": "Create Share",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expire_hours\": 24\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}/share",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{fileId}}",
                "share"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "if (json.share_code) pm.environment.set('shareCode', json.share_code);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Public Share Info",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/shares/{{shareCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "shares",
                "{{shareCode}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Public Share Download",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/shares/{{shareCode}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "shares",
                "{{shareCode}}",
                "download"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "07 Admin & Logs",
      "item": [
        {
          "name": "Set User Permissions",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\n    {\"method\": \"GET\", \"path\": \"/api/files\"},\n    {\"method\": \"POST\", \"path\": \"/api/files/folders\"}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{targetUserId}}/permissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users",
                "{{targetUserId}}",
                "permissions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Operation Logs (Permission Change)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/operation-logs?action=admin_permission_change&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "operation-logs"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "admin_permission_change"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Export Operation Logs CSV",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/operation-logs/export?action=admin_permission_change",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "operation-logs",
                "export"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "admin_permission_change"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "admin123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "folderId",
      "value": "0"
    },
    {
      "key": "uploadId",
      "value": ""
    },
    {
      "key": "fileId",
      "value": "0"
    },
    {
      "key": "shareCode",
      "value": ""
    },
    {
      "key": "targetUserId",
      "value": "2"
    }
  ]
}
