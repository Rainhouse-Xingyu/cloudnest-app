APP_PORT=8080

# MySQL DSN format:
# username:password@tcp(host:port)/database?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_DSN=cloudnest:CHANGE_ME@tcp(127.0.0.1:3306)/cloudnest?charset=utf8mb4&parseTime=True&loc=Local

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Required: generate a unique random secret, for example with openssl rand -hex 32.
# Placeholder below is deliberately rejected at startup.
JWT_SECRET=replace_with_a_strong_random_secret

# No automatic migrations or default administrator are created on startup.
# Run the explicit migrate command only after reviewing/backup of the target DB.
# For an empty user table, bootstrap-admin reads CLOUDNEST_BOOTSTRAP_PASSWORD.
# Supply it temporarily via the environment; do not save it in this file.

# 168 hours = 7 days
JWT_EXPIRE_HOURS=168

# AI (Ollama)
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=qwen3-vl:4b
# Relative to cloudnest_go working directory by default
AI_GUIDE_DOC_PATH=../../项目功能汇总.md
AI_TIMEOUT_SEC=120
