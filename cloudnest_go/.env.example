APP_PORT=8080

# MySQL DSN format:
# username:password@tcp(host:port)/database?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_DSN=cloudnest:CHANGE_ME@tcp(127.0.0.1:3306)/cloudnest?charset=utf8mb4&parseTime=True&loc=Local

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Use a strong random secret in production.
JWT_SECRET=replace_with_a_strong_random_secret

# 168 hours = 7 days
JWT_EXPIRE_HOURS=168

# AI (Ollama)
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=qwen3-vl:4b
# Relative to cloudnest_go working directory by default
AI_GUIDE_DOC_PATH=../../项目功能汇总.md
AI_TIMEOUT_SEC=120
